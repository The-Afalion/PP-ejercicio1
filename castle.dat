# Formato del fichero. Las lineas de datos reales empiezan por #p, #c, #o, #s o #l.
# Valores comunes: -1 = ninguno; booleanos 0 = no y 1 = si.
# p = jugador: id|nombre|gdesc|localizacion|salud|max_objetos|dinero|objeto_1|...|objeto_max|
# c = personaje: id|nombre|gdesc|localizacion|salud|amigable|mensaje|siguiendo|dinero|
# o = objeto: id|nombre|localizacion|descripcion|salud|movible|dependencia|abre|
# s = espacio: id|nombre|gdesc0|gdesc1|gdesc2|gdesc3|gdesc4|descubierto|
# l = enlace: id|nombre|origen|destino|direccion|abierto|
# Cada gdesc de espacio debe tener 13 caracteres.
